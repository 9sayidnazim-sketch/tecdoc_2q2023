# ==============================================================================
# Octaspards - UAE TecDoc Auto Parts Catalogue Environment Configuration
# All keys defined here are strictly SERVER-SIDE only. NEVER prefix with NEXT_PUBLIC_
# ==============================================================================

# PostgreSQL database connection (Port 5433 by default in local Docker container)
DATABASE_URL="postgresql://octaspards:octaspards@localhost:5433/octaspards?schema=public"

# Admin authentication token for privileged endpoints (/api/banners, /admin routes)
ADMIN_TOKEN="octaspards-admin-secret-key-2026"

# Ingest & Data Source Provider API Keys (Used server-side by backend adapters only)
TECDOC_API_KEY="tecdoc_partner_api_key_placeholder"
OEM_EPC_API_KEY="oem_parts_epc_api_key_placeholder"
AUTODOC_FEED_API_KEY="autodoc_partner_feed_key_placeholder"
DUBAI_SUPPLIER_FEED_KEY="dubai_central_parts_feed_key_placeholder"

# UAE Market Settings
UAE_VAT_PERCENT=5.0
DEFAULT_CURRENCY="AED"

# Node Environment
NODE_ENV="development"
PORT=3000
